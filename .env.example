# Fill these two PUBLIC values from the new Dear Choco Supabase project's
# Project Settings -> Data API / API Keys pages.
# Do not commit .env.local or put secret/service_role keys in VITE_* values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Kakao REST API key (public client ID; never put the client secret here)
VITE_KAKAO_REST_API_KEY=
